# Perfil local / pre-langsmith
ERP_FRAUD_ENV=local

# LangSmith (RF14b)
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGSMITH_PROJECT=erp-fraud-tfg
LANGSMITH_API_KEY=__set_me__
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Modelo LLM (si aplica)
OPENAI_API_KEY=__set_me__
OPENAI_PRICE_INPUT_PER_1M_USD=0
OPENAI_PRICE_OUTPUT_PER_1M_USD=0

# Runtime LLM (fallback seguro)
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_S=0.6

# Cloud (RF14c)
AWS_REGION=eu-west-1
RUN_MODE=local
S3_INPUT_URI=s3://tfg-fraud-dev-euw1-lucia01/inputs/
S3_OUTPUT_URI=s3://tfg-fraud-dev-euw1-lucia01/runs/
S3_STATE_URI=s3://tfg-fraud-dev-euw1-lucia01/state/
PROCESS_SCOPE=p2p
