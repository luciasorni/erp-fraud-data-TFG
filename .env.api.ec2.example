# Configuracion de FastAPI para EC2.
# Copia este fichero a .env.api.ec2 en la instancia y ajusta los valores.

# La API debe quedar solo en localhost. No abrir este puerto en el Security Group.
ERP_FRAUD_API_HOST=127.0.0.1
ERP_FRAUD_API_PORT=8000

# Configuracion AWS normal para que la API use S3 y lance tareas ECS Fargate.
AWS_REGION=eu-west-1
S3_INPUT_URI=s3://tfg-fraud-dev-euw1-lucia01/inputs/
S3_OUTPUT_URI=s3://tfg-fraud-dev-euw1-lucia01/runs/
API_ECS_CLUSTER=tfg-fraud-dev-ecs-cluster
API_ECS_TASK_DEFINITION=tfg-fraud-dev-task
API_ECS_SUBNETS=subnet-091fb9bd171d238aa,subnet-00cd0a8035d8f7dd6,subnet-0329d6462aeb6fdf7
API_ECS_SECURITY_GROUPS=sg-0bbcc120180a92672

# En EC2 se recomienda usar un IAM Role asociado a la instancia.
# Si se usa perfil local de AWS CLI, descomentar y ajustar:
# AWS_PROFILE=tfg-fraud-dev

# No incluir aqui secretos reales.
# OPENAI_API_KEY y LANGSMITH_API_KEY no los consume directamente esta API para servir la UI.
# Los runs reales los ejecuta ECS; esos secretos deben estar configurados en la task definition/Secrets Manager.
