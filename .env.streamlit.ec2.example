# Config publica/no sensible para desplegar solo la interfaz Streamlit en EC2.
# Copia este fichero a .env.streamlit.ec2 en la instancia y ajusta los valores.

# URL base de la API FastAPI que usa la UI. Debe incluir /api/v1.
# Para probar contra una API en la misma EC2:
# ERP_FRAUD_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Para probar contra una API publica/privada ya desplegada:
ERP_FRAUD_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Puerto publico de Streamlit.
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501

# No incluir aqui OPENAI_API_KEY, LANGSMITH_API_KEY ni credenciales AWS.
# La UI no las usa directamente; las necesita el backend/API si se lanzan runs reales.
